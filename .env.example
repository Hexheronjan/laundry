# Database MySQL
DATABASE_URL="mysql://user:password@localhost:3306/laundry"

# Auth.js — buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=""
# Wajib true bila di belakang reverse proxy (Nginx) pada produksi
AUTH_TRUST_HOST=true

# URL publik website (untuk sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Folder penyimpanan bukti transfer (di luar folder public)
UPLOAD_DIR="./storage/private-uploads"

# Akun admin awal untuk seed (ganti password setelah login pertama)
SEED_ADMIN_EMAIL="admin@laundry.local"
SEED_ADMIN_PASSWORD="GantiPassword123!"
